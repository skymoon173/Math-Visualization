# 忽略操作系统文件
.DS_Store
Thumbs.db

# 忽略编辑器文件
.vscode/
.idea/
*.swp
*.swo
*~

# 忽略编译产物
*.js.map
*.css.map

# 忽略依赖文件夹
node_modules/

# 忽略日志文件
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 忽略环境变量文件
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# 忽略备份文件
*.bak
* - 副本.js

# 忽略临时文件
*.tmp
*.temp

# 忽略Python脚本（如果不需要的话）
*.py
*.pyc
__pycache__/
